#!/usr/bin/env bash
# Stop hook for feature-coordinator: a worker session cannot finish its turn
# with contract drift or a failing gate.
#
# Runs only in a worker's feature worktree, and only when the worktree changed
# since the last check:
#   1. contract-check - locked contract files must match the merged plan
#   2. the repo's gate command (repos.tsv column 7, from --gate or the team
#      config), run in the worktree with a time limit
# On failure it blocks the stop once per worktree state with the reason and
# the tail of the log ({"decision":"block"} on stdout, which Claude Code,
# Copilot CLI and Codex all honour). Stopping again without changing anything
# is allowed - that is how a worker stops to ask its human partner something -
# and after three blocks in a row it lets the stop through regardless.
#
# Set FC_GATE=off to disable. Fails open on unexpected errors.

trap 'exit 0' EXIT

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LIB="${PLUGIN_ROOT}/skills/coordinating-multi-repo-features/scripts/fc-lib"
[ -r "$LIB" ] || exit 0
# shellcheck source=../skills/coordinating-multi-repo-features/scripts/fc-lib
. "$LIB" || exit 0

[ "${FC_GATE:-on}" = off ] && exit 0

PAYLOAD=$(cat 2>/dev/null)
fc_json_load "$PAYLOAD" P_ cwd
payload_cwd="${P_cwd:-}"
IDENTITY_DIR="${FC_SESSION_WORKTREE:-${CLAUDE_PROJECT_DIR:-${payload_cwd:-$PWD}}}"
IDENTITY_DIR=$(fc_to_unix "$IDENTITY_DIR")
case "$IDENTITY_DIR" in */.worktrees/*) ;; *) exit 0 ;; esac
fc_feature_context "$IDENTITY_DIR" || exit 0
[ "$FC_ROLE" = worker ] || exit 0

WT="$FC_TOPLEVEL"
GATES="$FC_STATE/gates"
mkdir -p "$GATES" 2>/dev/null || exit 0
PASS="$GATES/$FC_WHO.pass"
FAIL="$GATES/$FC_WHO.fail"
BLOCKS="$GATES/$FC_WHO.blocks"
LOG="$GATES/$FC_WHO.log"
MAX_BLOCKS="${FC_GATE_MAX_BLOCKS:-3}"
# Stay inside the harness's own hook timeout: Claude Code's hooks.json allows
# 900 s; Copilot CLI's default is 30 s.
if [ -n "${COPILOT_CLI:-}" ]; then LIMIT="${FC_GATE_TIMEOUT:-25}"; else LIMIT="${FC_GATE_TIMEOUT:-840}"; fi
ESC=$(printf '\033')

# Nothing to check until the worker has changed something.
main=$(fc_repo_field "$FC_STATE" "$FC_WHO" "$FC_COL_MAIN")
default=$(fc_default_branch "${main:-$WT}")
base="origin/$default"
git -C "$WT" rev-parse --verify --quiet "$base^{commit}" >/dev/null || base="$default"
ahead=$(git -C "$WT" rev-list --count "$base..HEAD" 2>/dev/null || printf 1)
dirty=$(git -C "$WT" status --porcelain 2>/dev/null | head -n 1)
[ "$ahead" = 0 ] && [ -z "$dirty" ] && exit 0

# fingerprint - HEAD, tracked changes and untracked files, content included
fingerprint() {
  {
    git -C "$WT" rev-parse HEAD
    git -C "$WT" diff HEAD --binary
    git -C "$WT" ls-files --others --exclude-standard -z |
      while IFS= read -r -d '' f; do
        printf '%s\n' "$f"
        git -C "$WT" hash-object -- "$f"
      done
  } 2>/dev/null | git hash-object --stdin
}

fp=$(fingerprint)
[ -n "$fp" ] || exit 0
if [ -f "$PASS" ] && [ "$(cat "$PASS" 2>/dev/null)" = "$fp" ]; then
  # Back on a state that already passed: that also ends a run of blocks.
  rm -f "$FAIL" "$BLOCKS"
  exit 0
fi
if [ -f "$FAIL" ] && [ "$(cat "$FAIL" 2>/dev/null)" = "$fp" ]; then
  # Same state as the failure we already reported: the worker chose to stop.
  printf '{"systemMessage": "%s"}\n' "$(fc_json_escape "feature-gate: checks for $FC_WHO are still failing on this state; see $LOG")"
  exit 0
fi

reason=""
contract_out=$(cd "$WT" && bash "$FC_SCRIPT" contract-check "$FC_ID" --repo "$FC_WHO" --quiet 2>&1)
if [ $? -ne 0 ]; then
  reason="Contract drift: locked contract files in $FC_WHO differ from the merged plan.
$contract_out"
fi

# run_gate - the gate command in the worktree, killed after LIMIT seconds
# (exit 124), with or without coreutils' timeout (stock macOS has none).
run_gate() {
  local pid watchdog st flag="$GATES/$FC_WHO.timedout"
  rm -f "$flag"
  # FC_GATE_PORTABLE_TIMEOUT=1 forces the built-in watchdog (used by the tests).
  if [ "${FC_GATE_PORTABLE_TIMEOUT:-0}" != 1 ] && command -v timeout >/dev/null 2>&1; then
    (cd "$WT" && timeout "$LIMIT" bash -c "$gate") >"$LOG" 2>&1 </dev/null
    return $?
  fi
  (cd "$WT" && exec bash -c "$gate") >"$LOG" 2>&1 </dev/null &
  pid=$!
  (
    trap 'kill "$sl" 2>/dev/null; exit 0' TERM
    sleep "$LIMIT" &
    sl=$!
    wait "$sl"
    if kill -0 "$pid" 2>/dev/null; then
      : >"$flag"
      pkill -TERM -P "$pid" 2>/dev/null
      kill -TERM "$pid" 2>/dev/null
    fi
  ) >/dev/null 2>&1 &
  watchdog=$!
  wait "$pid"
  st=$?
  kill -TERM "$watchdog" 2>/dev/null
  wait "$watchdog" 2>/dev/null
  if [ -f "$flag" ]; then
    rm -f "$flag"
    return 124
  fi
  return "$st"
}

gate=$(fc_repo_field "$FC_STATE" "$FC_WHO" "$FC_COL_GATE")
if [ -z "$reason" ] && [ -n "$gate" ]; then
  # Record the attempt first: if the harness kills this hook mid-gate, the
  # next stop on the same state goes through instead of stalling again.
  printf '%s\n' "$fp" >"$FAIL"
  start=$(date +%s)
  run_gate
  rc=$?
  took=$(($(date +%s) - start))
  if [ "$rc" -eq 124 ]; then
    printf '{"systemMessage": "%s"}\n' "$(fc_json_escape "feature-gate: the gate for $FC_WHO ($gate) did not finish within ${LIMIT}s; run it yourself before pushing (log: $LOG). Raise FC_GATE_TIMEOUT or keep the gate fast.")"
    exit 0
  fi
  if [ "$rc" -ne 0 ]; then
    reason="Gate for $FC_WHO failed (exit $rc) after ${took}s: $gate
Last lines of $LOG:
$(tail -n 40 "$LOG" 2>/dev/null | sed "s/${ESC}\[[0-9;?]*[ -\/]*[@-~]//g")"
  fi
fi

if [ -z "$reason" ]; then
  printf '%s\n' "$fp" >"$PASS"
  rm -f "$FAIL" "$BLOCKS"
  exit 0
fi

n=$(cat "$BLOCKS" 2>/dev/null || printf 0)
case "$n" in '' | *[!0-9]*) n=0 ;; esac
n=$((n + 1))
printf '%s\n' "$fp" >"$FAIL"
printf '%s\n' "$n" >"$BLOCKS"
if [ "$n" -gt "$MAX_BLOCKS" ]; then
  rm -f "$BLOCKS"
  printf '{"systemMessage": "%s"}\n' "$(fc_json_escape "feature-gate: letting $FC_WHO stop after $MAX_BLOCKS blocked attempts; checks still fail - see $LOG")"
  exit 0
fi

reason="feature-coordinator gate: do not stop yet.
$reason

Fix this before you finish the turn. If you must stop to ask your human partner something, say so and stop again without changing anything - the gate does not block twice on the same state."
printf '{"decision": "block", "reason": "%s"}\n' "$(fc_json_escape "$reason")"
exit 0
